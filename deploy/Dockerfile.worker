# Сборка воркера для stage/production.
# Использование: docker build -f deploy/Dockerfile.worker --build-arg WORKER=import -t seller/worker-import:latest .
# WORKER: import | publish | sync-stock | email
ARG WORKER=import
FROM node:22-alpine AS builder

WORKDIR /app

COPY . .

RUN npm ci

ARG WORKER
# shared, domain — nx:run-commands; email-module — для worker-email; worker — tsc (без @nx/js)
RUN npx nx run shared:build && npx nx run domain:build && \
    (if [ "$WORKER" = "email" ]; then npx nx run email-module:build; fi) && \
    npx tsc -p apps/worker-${WORKER}/tsconfig.json

# Runtime
FROM node:22-alpine AS runner

WORKDIR /app

ARG WORKER=import
ENV WORKER=$WORKER
ENV NODE_ENV=production

COPY --from=builder /app/package.json /app/package-lock.json ./
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/packages ./packages
COPY --from=builder /app/dist ./dist

# Без отдельного скрипта — Alpine busybox иногда ломает exec скриптов
ENTRYPOINT ["/bin/sh", "-c", "exec node --import=extensionless/register /app/dist/apps/worker-$WORKER/main.js"]
