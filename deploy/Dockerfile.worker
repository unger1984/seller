# Сборка воркера для stage/production.
# Использование: docker build -f deploy/Dockerfile.worker --build-arg WORKER=import -t seller/worker-import:latest .
# WORKER: import | publish | sync-stock
ARG WORKER=import
FROM node:22-alpine AS builder

WORKDIR /app

COPY . .

RUN npm ci

# Сборка: shared, domain, worker-lib через nx; worker-* через tsc (nx @nx/js в Docker недоступен)
ARG WORKER
RUN npx nx run shared:build && \
    npx nx run domain:build && \
    npx nx run worker-lib:build && \
    npx tsc -p apps/worker-${WORKER}/tsconfig.json

# Runtime
FROM node:22-alpine AS runner

WORKDIR /app

ARG WORKER=import
ENV NODE_ENV=production

COPY --from=builder /app/package.json /app/package-lock.json ./
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/packages ./packages
COPY --from=builder /app/dist ./dist

# Точка входа зависит от WORKER (build arg)
RUN echo "#!/bin/sh\nexec node dist/apps/worker-${WORKER}/src/main.js" > /entrypoint.sh && chmod +x /entrypoint.sh
ENTRYPOINT ["/entrypoint.sh"]
