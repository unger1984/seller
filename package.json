{
  "name": "seller",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*",
    "tooling/*"
  ],
  "scripts": {
    "build": "nx run-many -t build --projects=shared,shared-types,domain,typeorm,email-module,api,web,worker-import,worker-publish,worker-sync-stock,worker-email",
    "build:api": "tsc -p apps/api",
    "build:web": "vite build --config apps/web/vite.config.ts",
    "build:worker": "nx run-many -t build -p worker-import,worker-publish,worker-sync-stock,worker-email",
    "docker:worker:import": "docker build -f deploy/Dockerfile.worker --build-arg WORKER=import -t seller/worker-import:latest .",
    "docker:worker:publish": "docker build -f deploy/Dockerfile.worker --build-arg WORKER=publish -t seller/worker-publish:latest .",
    "docker:worker:sync-stock": "docker build -f deploy/Dockerfile.worker --build-arg WORKER=sync-stock -t seller/worker-sync-stock:latest .",
    "docker:worker:email": "docker build -f deploy/Dockerfile.worker --build-arg WORKER=email -t seller/worker-email:latest .",
    "certs": "mkdir -p tooling/certs && openssl req -x509 -newkey rsa:2048 -keyout tooling/certs/localhost-key.pem -out tooling/certs/localhost.pem -days 365 -nodes -subj \"/CN=localhost\"",
    "dev:api": "nx serve api",
    "dev:web": "nx serve web",
    "dev:worker:all": "nx run-many -t serve -t run -p worker-import,worker-publish,worker-sync-stock",
    "dev:worker:import:stage": "dotenv -e .env.stage -- nx run worker-import:run",
    "dev:worker:publish:stage": "dotenv -e .env.stage -- nx run worker-publish:run",
    "dev:worker:sync-stock:stage": "dotenv -e .env.stage -- nx run worker-sync-stock:run",
    "dev:worker:email:stage": "dotenv -e .env.stage -- nx run worker-email:run",
    "dev:api:stage": "APP_ENV=stage nx serve api",
    "dev:worker:stage": "dotenv -e .env.stage -- nx run-many -t serve -t run -p worker-import,worker-publish,worker-sync-stock,worker-email",
    "dev:stage": "APP_ENV=stage nx serve api",
    "lint": "nx run-many -t lint",
    "format": "prettier --write \"**/*.{ts,tsx,json}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,json}\"",
    "db:migrate": "nx build typeorm && cd packages/typeorm && node ../../node_modules/typeorm/cli.js migration:run -d dist/data-source.js",
    "db:migrate:stage": "dotenv -e .env.stage -- npm run db:migrate",
    "db:migration:generate": "nx build typeorm && dotenv -e .env.stage -- node node_modules/typeorm/cli.js migration:generate -d packages/typeorm/dist/data-source.js",
    "deploy:stage": "./deploy/stage/apply.sh",
    "deploy:workers:stage": "./tooling/scripts/deploy-workers-stage.sh",
    "db:studio": "echo 'Use psql $DATABASE_URL or DBeaver'",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepare": "husky"
  },
  "devDependencies": {
    "dotenv-cli": "7.4.2",
    "eslint": "9.39.2",
    "husky": "9.1.7",
    "lint-staged": "16.2.7",
    "nx": "22.0.0",
    "prettier": "3.4.0",
    "typescript": "5.6.3",
    "typescript-eslint": "8.0.0",
    "vite-tsconfig-paths": "6.1.1",
    "vitest": "3.2.4"
  },
  "overrides": {
    "jest-resolve": "29.2.0"
  },
  "dependencies": {
    "@nestjs/swagger": "11.2.6",
    "extensionless": "^2.0.6",
    "nestjs-zod": "4.3.1",
    "zod": "3.23.8"
  },
  "type": "module",
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.json": [
      "prettier --write"
    ]
  }
}
