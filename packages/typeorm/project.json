{
  "name": "typeorm",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/typeorm",
  "projectType": "library",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{projectRoot}/dist"],
      "options": {
        "command": "tsc -p packages/typeorm",
        "cwd": "{workspaceRoot}"
      }
    },
    "migration:generate": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node --loader ts-node/esm ../../node_modules/typeorm/cli.js migration:generate -d dist/data-source.js",
        "cwd": "packages/typeorm"
      }
    },
    "migration:run": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node --loader ts-node/esm ../../node_modules/typeorm/cli.js migration:run -d dist/data-source.js",
        "cwd": "packages/typeorm"
      }
    }
  }
}
